---
import ContactForm from "./ContactForm.jsx";
---

<section
  class="contact-section relative py-20 px-6 bg-gradient-to-br from-[#fbe4e9] via-[#f5d0fe] to-[#fffaf0] text-dark fade-in overflow-hidden"
>
  <div
    class="absolute -top-10 -left-10 w-96 h-96 bg-pink-300 opacity-20 blur-3xl rounded-full animate-pulse-slow z-0"
  >
  </div>
  <div
    class="absolute -bottom-10 -right-10 w-96 h-96 bg-fuchsia-300 opacity-20 blur-3xl rounded-full animate-pulse-slow z-0"
  >
  </div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <h2
      class="text-4xl md:text-5xl font-extrabold font-display text-center mb-12 text-accent drop-shadow-lg relative inline-block after:content-[''] after:block after:w-1/2 after:h-1 after:bg-pink-400 after:mx-auto after:rounded-full after:mt-3"
    >
      Contáctame
    </h2>

    <p class="text-lg text-dark/80 mb-10">
      ¿Tienes una consulta o quieres reservar una cita? Rellena el formulario y
      te responderé lo antes posible.
    </p>

    <ContactForm client:load />
  </div>
</section>
