---
const title = "Stiletto Nailz";
---

<section
  class="hero-section relative min-h-screen text-gray-800 flex flex-col justify-center items-center text-center px-4 overflow-hidden"
  style="
    background: linear-gradient(
      145deg,
      rgba(255, 245, 248, 0.98) 0%,
      rgba(255, 240, 247, 0.96) 30%,
      rgba(255, 235, 245, 0.94) 50%,
      rgba(250, 230, 250, 0.92) 70%,
      rgba(245, 225, 245, 0.9) 100%
    );
  "
>
  <div class="absolute top-6 right-6 flex gap-4 z-30">
    <a
      href="https://instagram.com/stiletto.nailz"
      target="_blank"
      rel="noopener noreferrer"
      class="text-pink-600/80 hover:text-pink-700 transition-transform hover:scale-110"
      aria-label="Instagram Stiletto Nailz"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm4.75-2a1.25 1.25 0 1 1-2.5 0 1.25 1.25 0 0 1 2.5 0z"
        ></path>
      </svg>
    </a>
    <a
      href="mailto:nereaeffy@gmail.com"
      class="text-pink-600/80 hover:text-pink-700 transition-transform hover:scale-110"
      aria-label="Email Stiletto Nailz"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2zm8 7L4.5 6.75A.5.5 0 0 0 4 7v10c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V7a.5.5 0 0 0-.5-.25L12 11z"
        ></path>
      </svg>
    </a>
  </div>

  <div class="hero-logo-wrapper relative inline-block">
    <div class="relative">
      <img
        src="/images/logo.png"
        alt="Logo Stiletto Nailz"
        class="hero-logo w-56 md:w-72 lg:w-[22rem] mb-6 opacity-0 scale-90 transition-all duration-1000 ease-out drop-shadow-[0_8px_25px_rgba(236,72,153,0.15)] relative z-30 hover:scale-[1.02] hover:drop-shadow-[0_10px_30px_rgba(236,72,153,0.25)]"
        style="animation: float 6s ease-in-out infinite"
      />
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-pink-300/20 rounded-full blur-2xl animate-pulse" style="animation-duration: 4s"></div>
        <div class="absolute inset-0 bg-fuchsia-300/20 rounded-full blur-2xl animate-pulse" style="animation-delay: 1s; animation-duration: 5s"></div>
      </div>
    </div>

    <span class="sparkle-container absolute inset-0 z-0"></span>
  </div>

  <div class="relative flex flex-col items-center mb-8 px-4">
    <p
      class="hero-subtitle max-w-2xl text-2xl md:text-3xl lg:text-4xl font-display font-medium text-pink-700 text-center leading-tight tracking-wide"
      style="text-shadow: 0 2px 8px rgba(236, 72, 153, 0.1)"
    >
      <span class="block">Convirtiendo tus uñas de fantasía en realidad.</span>
    </p>
    <span
      class="block mt-6 w-48 h-1 rounded-full bg-gradient-to-r from-pink-300 via-fuchsia-400 to-purple-300 opacity-70"
    ></span>
  </div>

  <a
    href="#gallery"
    class="hero-cta relative inline-block px-10 py-4 text-white font-semibold rounded-full overflow-hidden z-10 shadow-xl group focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-pink-400 glam-button"
  >
    <span class="relative z-10">Ver Galería</span>
    <span
      class="absolute inset-0 bg-gradient-to-r from-pink-400 via-fuchsia-500 to-rose-400 opacity-90 group-hover:opacity-100 transition-opacity duration-300"
    ></span>
    <span
      class="absolute -left-1/4 top-0 w-1/2 h-full bg-white/40 blur-xl transform -skew-x-12 opacity-0 group-hover:opacity-100 animate-sparkle pointer-events-none"
    ></span>
  </a>

  <div
    class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-fuchsia-600 to-transparent pointer-events-none"
  >
  </div>
</section>
